# SentinAI Environment Variables Configuration

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase / Postgres)
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL database
# IMPORTANT: Use 'postgresql://' instead of 'postgres://' if using SQLAlchemy
DATABASE_URL=postgresql://user:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# (Optional) Direct Supabase URL and Key if you plan to use Supabase Client
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# CORS & FRONTEND
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for the backend. Use * for testing.
FRONTEND_URL=https://your-frontend-vercel-domain.vercel.app

# -----------------------------------------------------------------------------
# AI / LLM COPILOT CONFIGURATION
# -----------------------------------------------------------------------------
# Only ONE of these is strictly required for Copilot to function.
# The backend will automatically select the first available key.
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# EXTERNAL APIS (Optional but recommended)
# -----------------------------------------------------------------------------
# Google Maps API Key for the Suppliers module (must have Places API enabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Secret used for JWT generation (if authentication is added later)
JWT_SECRET=supersecret-change-in-production
